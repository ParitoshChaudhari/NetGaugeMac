<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Apple App Sandbox Core Requirement -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound Network Access for Traffic Monitoring & Socket Queries -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Inbound / Local Interface Network Access -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Location Services Entitlement for CoreWLAN SSID Resolution -->
    <key>com.apple.security.personal-information.location</key>
    <true/>

    <!-- Read/Write File Permission for Exported Reports & User Selection -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
